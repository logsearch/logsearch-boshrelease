input {
	relp {
		add_field => ["_logstash_input", "relp"]
		host => "0.0.0.0"
		port => "<%= p("logstash_ingestor.relp.port") %>"
	}
<% p("cf.tenants", "").to_s.split(',').each_with_index do |tenant, i| %>
	relp {
		add_field => [ 
			"_logstash_input", "relp",
			"tenant", "<%= tenant.strip %>"
		]
		host => "0.0.0.0"
		port => "<%= p("logstash_ingestor.relp.port") + (i + 49626) %>"
	}
<% end %>
}
			
output {
	<% if p("logstash_ingestor.debug") %>
        stdout {
            codec => "json"
        }
	<% end %>

<% p("cf.tenants").to_s.split(',').each do |tenant| %>
	redis {
		host => "<%= p("redis.host") %>"
		port => "<%= p("redis.port") %>"
		data_type => "list"
		key => "<%= p("redis.key") %>-%{tenant}"
		batch => true
		batch_events => 50
	}
<% end %>
}
