input {
	<% if p("logstash_ingestor.syslog.port") %>
			tcp {
				add_field => ["type", "syslog"]
				host => "0.0.0.0"
				port => "<%= p("logstash_ingestor.syslog.port") %>"
			}
			udp {
				add_field => ["type", "syslog"]
				host => "0.0.0.0"
				port => "<%= p("logstash_ingestor.syslog.port") %>"
			}
		<% p("tenants").to_s.split(',').each_with_index do | tenant, i |  %>
			tcp {
				add_field => [ 
					"type", "syslog",
					"tenant", "<%= tenant.strip %>"
				]
				host => "0.0.0.0"
				port => "<%= p("logstash_ingestor.syslog.port") + ((i + 1) * (10)) %>"
			}
			udp {
				add_field => [ 
					"type", "syslog",
					"tenant", "<%= tenant.strip %>"
				]
				host => "0.0.0.0"
				port => "<%= p("logstash_ingestor.syslog.port") + ((i + 1) * (10))  %>"
			}
		<% end %>
	<% end %>

	<% if p("logstash_ingestor.syslog_tls.port") %>
		    tcp {
		    	add_field => ["type", "syslog"]
		    	host => "0.0.0.0"
			 	port => "<%= p("logstash_ingestor.syslog_tls.port") %>"
			 	ssl_enable => true
			 	ssl_cert => "/var/vcap/jobs/ingestor_syslog/config/syslog_tls.crt"
			 	ssl_key => "/var/vcap/jobs/ingestor_syslog/config/syslog_tls.key"
			}
	    <% p("tenants").to_s.split(',').each_with_index do | tenant, i | %>
		    tcp {
		    	add_field => [ 
			 		"type", "syslog",
			 		"tenant", "<%= tenant.strip %>"
			 	]
			 	host => "0.0.0.0"
			 	port => "<%= p("logstash_ingestor.syslog_tls.port") + ((i + 1) * (10)) %>"
			 	ssl_enable => true
			 	ssl_cert => "/var/vcap/jobs/ingestor_syslog/config/syslog_tls.crt"
			 	ssl_key => "/var/vcap/jobs/ingestor_syslog/config/syslog_tls.key"
			 }
		<% end %>
	<% end %>
}

filter {
    mutate {
        rename => [ "host", "@ingestor.remote_host" ]
        rename => [ "sslsubject", "@ingestor.sslsubject" ]
    }
}

output {
	<% if p("logstash_ingestor.debug") %>
        stdout {
            codec => "json"
        }
	<% end %>

	redis {
		host => "<%= p("redis.host") %>"
		port => "<%= p("redis.port") %>"
		data_type => "list"
		key => "<%= p("redis.key") %>-%{tenant}"
		batch => true
		batch_events => 50
	}
}